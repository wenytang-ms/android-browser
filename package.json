{
  "name": "andriod-browser",
  "version": "0.0.2-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:server": "node scripts/prepare-server.mjs",
    "prepare:notices": "node scripts/prepare-notices.mjs",
    "release:version": "node scripts/release-version.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "node --experimental-strip-types scripts/browser-smoke.mjs",
    "build": "npm run prepare:server && npm run prepare:notices && npm run typecheck && vite build --mode extension && vite build --mode viewer && tsc -p tsconfig.relay.json",
    "start": "node dist/relay/relay/main.js",
    "dev:viewer": "vite --mode viewer --host 127.0.0.1",
    "dev:relay": "tsc -p tsconfig.relay.json && node dist/relay/relay/main.js"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/stream-extra": "2.6.1",
    "jose": "6.2.17",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "22.20.5",
    "@types/w3c-web-usb": "1.0.10",
    "@types/ws": "8.5.14",
    "playwright-core": "1.65.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
